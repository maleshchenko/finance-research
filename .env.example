# ── LLM ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/financial_research
DATABASE_POOL_SIZE=5            # keep low, multiply by ECS task count
DATABASE_MAX_OVERFLOW=5

# ── Vector store ─────────────────────────────────────────────────────
VECTOR_DIMENSION=1536          # text-embedding-3-small
SIMILARITY_TOP_K=8
SIMILARITY_THRESHOLD=0.35

# ── Ingestion ─────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=50

# ── Agent ─────────────────────────────────────────────────────────────
AGENT_MAX_ITERATIONS=12
AGENT_TEMPERATURE=0.1

# ── S3 (optional — store original PDFs durably) ───────────────────────
# S3_BUCKET=my-financial-docs-bucket
# AWS_REGION=us-east-1

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.  Use * only in local dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
