# Version control
.git
.gitignore

# Python artefacts
__pycache__
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info
dist/
build/
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Virtual environments
.venv
venv/
env/

# Local secrets, never bake into the image
.env
.env.*
!.env.example

# Local uploads / sample docs (mounted as volume at runtime)
sample_docs/
uploads/

# Docs and tooling config that don't affect the build
README.md
CHANGELOG.md
docs/
.editorconfig
.pre-commit-config.yaml
Makefile

# IDEs
.vscode/
.idea/
*.sublime-*
